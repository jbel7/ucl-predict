# Copy to .env (never commit .env) and fill in real values for production.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional: where the SQLite file lives (defaults to ./db.sqlite3)
DJANGO_DB_PATH=
# Optional: live data from football-data.org (free key). Leave blank to use database data only.
FOOTBALL_DATA_API_KEY=
